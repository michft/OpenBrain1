# Convex deploy metadata. `npx convex dev` fills CONVEX_DEPLOYMENT.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# OB1 API compatibility key. Existing clients still send this as `x-brain-key`
# or `?key=...`. 
# good generator
# openssl rand -hex 32
MCP_ACCESS_KEY=

# Embeddings and classification stay on OpenRouter/OpenAI-compatible models.
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPEN_BRAIN_EMBEDDING_MODEL=openai/text-embedding-3-small
OPEN_BRAIN_CLASSIFICATION_MODEL=openai/gpt-4o-mini

# Optional citation root for MCP search/fetch compatibility.
OPEN_BRAIN_CITATION_BASE_URL=https://openbrain.local/thoughts

# Linear.app integration for issue tracking and project management.
# Get API key: https://app.linear.app/settings/api
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINEAR_BASE_URL=https://api.linear.app/graphql

# Dashboard examples:
# NEXT_PUBLIC_API_URL=https://YOUR_DEPLOYMENT.convex.site
# AGENT_MEMORY_API_URL=https://YOUR_DEPLOYMENT.convex.site/agent-memory-api
