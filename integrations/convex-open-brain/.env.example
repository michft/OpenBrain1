# Convex deployment metadata. `pnpm convex dev --once` fills these values.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
NEXT_PUBLIC_CONVEX_URL=

# OB1 API compatibility key. Existing clients still send this as `x-brain-key`
# or `?key=...`. 
# good generator
# openssl rand -hex 32
MCP_ACCESS_KEY=

# Separate human/admin credential for review and trusted imports. Never give to agents.
# Generate independently from MCP_ACCESS_KEY; equal keys cannot authorize admin actions.
MCP_ADMIN_KEY=

# Optional comma-separated browser origins. Native clients normally omit Origin.
# Same-origin requests are allowed. Unlisted origins are rejected by /mcp.
MCP_ALLOWED_ORIGINS=

# Embeddings use the existing OpenRouter/OpenAI-compatible model.
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPEN_BRAIN_EMBEDDING_MODEL=openai/text-embedding-3-small
OPEN_BRAIN_CLASSIFICATION_MODEL=openai/gpt-4o-mini

# Optional independent classification provider (set BOTH; HTTPS base ends in /v1).
# Use a model ID advertised by that provider with OPEN_BRAIN_CLASSIFICATION_MODEL.
# Unset both to retain OpenRouter classification. Incomplete/invalid pairs use
# local metadata fallback and never send OPENROUTER_API_KEY to the alternate host.
OPEN_BRAIN_CLASSIFICATION_BASE_URL=
OPEN_BRAIN_CLASSIFICATION_API_KEY=

# Optional citation root for MCP search/fetch compatibility.
OPEN_BRAIN_CITATION_BASE_URL=https://YOUR_DEPLOYMENT.convex.site/thought

# Linear.app integration for issue tracking and project management.
# Get API key: https://app.linear.app/settings/api
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINEAR_BASE_URL=https://api.linear.app/graphql

# Dashboard examples:
# NEXT_PUBLIC_API_URL=https://YOUR_DEPLOYMENT.convex.site
# AGENT_MEMORY_API_URL=https://YOUR_DEPLOYMENT.convex.site/agent-memory-api
