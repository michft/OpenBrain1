# MCP Server credentials
# Copy this file to `.env.local` for local development.
# SvelteKit only picks up env changes after restarting `npm run dev`.
#
# Tip: symlink from the repo root so all dashboards share one file:
#   ln -s ../../.env.local dashboards/open-brain-dashboard/.env.local
#
# Preferred (server-only, does not expose key in browser):
MCP_URL=https://your-convex-deployment.convex.site/mcp
MCP_KEY=your-access-key
#
# Backward-compatible fallback (works, but values are public in browser bundle):
# PUBLIC_MCP_URL=https://your-convex-deployment.convex.site/mcp
# PUBLIC_MCP_KEY=your-access-key

# Legacy Supabase validation target:
# MCP_URL=https://your-project.supabase.co/functions/v1/open-brain-mcp
#
# Supabase auth credentials are only needed when validating the legacy
# SvelteKit/Supabase auth path.
# PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=your-anon-key
