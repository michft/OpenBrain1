# Open Brain — Local Ollama Embeddings
# Copy this file to .env and fill in your values.
# Then: export $(cat .env | xargs)

# Convex Open Brain API (default for new installs)
OB1_API_URL=https://YOUR_CONVEX_DEPLOYMENT.convex.site
OB1_API_KEY=your-mcp-access-key-here

# Legacy Supabase validation path:
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Ollama (optional — defaults shown)
# OLLAMA_BASE_URL=http://localhost:11434
